# Cloud server: use relay state pushed by the Windows recognition computer.
LM_VISION_SOURCE=relay

# Generate a long random value and configure the exact same value on the
# cloud service and on the Windows cloud_relay.py process.
LM_RELAY_TOKEN=replace-with-a-long-random-secret

# Used only by cloud_relay.py on the recognition computer.
LM_CLOUD_URL=https://your-domain.example

# Optional persistent paths for container hosting.
LM_RELAY_STATE_PATH=/data/relay_state.json

LM_RUNTIME_ROOT=/data
LM_BOOKS_ROOT=/data/books
LM_RELAY_MAX_AGE_SECONDS=15
