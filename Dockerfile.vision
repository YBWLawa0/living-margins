FROM python:3.11-slim

WORKDIR /app
COPY requirements-cloud-vision.txt /app/requirements-cloud-vision.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /app/requirements-cloud-vision.txt \
    && pip install --no-cache-dir --no-deps -i https://pypi.tuna.tsinghua.edu.cn/simple "rapidocr-onnxruntime>=1.3.24,<2"

COPY library_terra /app/library_terra
COPY app.py /app/app.py
COPY config.json /app/config.json
COPY cloud_vision_worker.py /app/cloud_vision_worker.py

ENV PYTHONUNBUFFERED=1 \
    LM_MOBILE_FRAME_ROOT=/data/mobile_frames \
    LM_BOOKS_ROOT=/data/books \
    LM_RELAY_STATE_PATH=/data/relay_state.json

CMD ["python", "cloud_vision_worker.py"]